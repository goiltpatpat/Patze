{
  "name": "patze",
  "version": "0.1.0",
  "description": "Patze: Evidence-Driven Autonomous Agent Engineering Platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "patze": "./bin/patze.js"
  },
  "scripts": {
    "setup": "git submodule update --init --recursive && pnpm --dir engine/deepseek-harness install && pnpm build",
    "postinstall": "git submodule update --init --recursive",
    "web": "./bin/patze.js web",
    "headless": "./bin/patze.js headless",
    "dsh": "./bin/patze.js",
    "build": "pnpm --dir engine/deepseek-harness run build",
    "test": "pnpm --dir engine/deepseek-harness run test",
    "test:imagine": "node --test src/tools/xai-imagine.test.js",
    "test:jev": "node --test src/jev/router.test.js src/jev/steer.test.js",
    "test:unit": "node --test src/jev/router.test.js src/jev/steer.test.js src/tools/xai-imagine.test.js",
    "update-skills": "./bin/patze.js update-skills",
    "sync-skills": "./bin/patze.js update-skills"
  },
  "keywords": [
    "patze",
    "deepseek-harness",
    "cordis",
    "patpat",
    "autonomous-agents",
    "evidence-driven"
  ],
  "author": "goiltpatpat",
  "license": "MIT"
}
