@@ -21,0 +22 @@ import {
+  rewriteImporterError,
@@ -653,0 +655,12 @@ describe('runtime resolution', { concurrent: false }, () => {
+  it('does not mask immutable native resolver errors while restoring the importer', () => {
+    const routedParent = pathToFileURL(join(tmpdir(), 'routed-importer.mjs')).href
+    const parent = pathToFileURL(join(tmpdir(), 'original-importer.mjs')).href
+    const originalError = new Error(`Package subpath was resolved from ${routedParent}`) as NodeJS.ErrnoException
+    originalError.code = 'ERR_PACKAGE_PATH_NOT_EXPORTED'
+    Object.freeze(originalError)
+
+    expect(() => rewriteImporterError(originalError, routedParent, parent)).not.toThrow()
+    expect(rewriteImporterError(originalError, routedParent, parent)).toBe(originalError)
+    expect(originalError.code).toBe('ERR_PACKAGE_PATH_NOT_EXPORTED')
+  })
