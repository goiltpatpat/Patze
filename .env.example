# Patze Platform Environment Configuration
# Copy this file to .env and configure your credentials


# DeepSeek Official API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Custom API Base URL (if using a proxy, compatible provider, or local endpoint)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Port settings for Web UI (defaults to 3080)
# PORT=3080
# HOST=127.0.0.1

# Optional: Jev (TypeSafe AI) System 1 Fast Decision & Routing Layer
# If omitted, Patze automatically uses its built-in System 1 heuristic engine (<5ms latency)
# JEV_API_KEY=your_jev_api_key_here
# JEV_BASE_URL=https://api.typesafe.ai/v1
