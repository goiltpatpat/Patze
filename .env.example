# ==============================================================================
# Patze Platform Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System 2 Reasoning Models (Primary Intelligence & Autonomous Coding)
# ------------------------------------------------------------------------------

# DeepSeek (Official): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional: DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alias:
# GOOGLE_API_KEY=your_gemini_api_key_here

# xAI (Grok): https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Moonshot AI (Kimi): https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=your_moonshot_api_key_here
# Optional alias:
# KIMI_API_KEY=your_kimi_api_key_here

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter (Aggregator for 200+ models): https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 2. System 1 Decision & Control Engine (TypeSafe AI / Jev)
# ------------------------------------------------------------------------------
# TypeSafe AI / Jev System One: https://console.typesafe.ai/keys
# (If omitted, Patze uses its built-in local heuristic engine with <5ms latency)
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Optional alias:
# JEV_API_KEY=your_typesafe_api_key_here
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# ------------------------------------------------------------------------------
# 3. Web UI Console & Networking Settings
# ------------------------------------------------------------------------------
PORT=3080
HOST=127.0.0.1
