# Patze Platform Environment Configuration
# Copy this file to .env and configure your credentials


# DeepSeek Official API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Custom API Base URL (if using a proxy, compatible provider, or local endpoint)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Port settings for Web UI (defaults to 3080)
# PORT=3080
# HOST=127.0.0.1

# Optional: TypeSafe AI / Jev System One Configuration
# Get your API key at: https://console.typesafe.ai/keys
# If omitted, Patze runs its 100% free built-in local heuristic engine (<5ms latency)
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Optional alias:
# JEV_API_KEY=your_typesafe_api_key_here
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
